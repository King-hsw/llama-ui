{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llama-ui",
  "version": "0.1.0-alpha.2",
  "identifier": "com.hongsw.llama-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "llama-ui · llama.cpp 启动器",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRTQzNzkwOEIxNTczNkEKUldScWN4V0xrRGZrZmtYbk44dDdJQ05tNFk4SUxMUG5ZMDU5S1FDdk15SUFpZVRvWFRyOXJnZGsK",
      "endpoints": [
        "https://github.com/King-hsw/llama-ui/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
